# 必填：请生成高熵随机值，例如 openssl rand -hex 32
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
TELEGRAM_BOT_TOKEN=123456:replace_me
# 多个 ID 用英文逗号分隔；留空则机器人拒绝全部请求
TELEGRAM_ALLOWED_IDS=123456789
# rclone.conf 所在的宿主机目录（其中必须包含 rclone.conf）
RCLONE_CONFIG_HOST_PATH=./rclone
RCLONE_CONFIG=/config/rclone.conf
DATA_DIR=/data
TEMP_DIR=/downloads
LOG_DIR=/logs
DEFAULT_REMOTE=gd
DEFAULT_DIR=
MAX_CONCURRENCY=2
DOWNLOAD_LIMIT=0
UPLOAD_LIMIT=0
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
